%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '14px'}}}%%
graph TB
    %% =====================================================================
    %% SYSTEM ARCHITECTURE DIAGRAM
    %% Privacy-Preserving and Resource-Aware Federated Learning
    %% Notation: Mermaid graph (top-to-bottom)
    %% =====================================================================

    subgraph PL["PRESENTATION LAYER"]
        direction LR
        ADMIN["Admin"]
        DASH["Web Dashboard"]
    end

    subgraph AL["API LAYER"]
        direction LR
        API["Backend API"]
        AUTH["Auth Service"]
    end

    subgraph FCL["FL COORDINATION LAYER  (Central Server)"]
        direction LR
        FLCOORD["FL Coordinator"]
        SECAGG["Secure Aggregation"]
        GLOBAGG["Global Aggregator"]
    end

    subgraph EPL["EDGE DEVICE LAYER  (Physical Devices)"]
        direction LR
        FLC["FL Client"]
        LT["Local Trainer"]
        DS[("Local Dataset\n(Stays on Device)")]
        PRIV["Privacy & Compression\n(DP + Sparsification + SecAgg Masking)"]
    end

    subgraph DSL["DATA STORAGE LAYER"]
        DB[("Central Database")]
    end

    %% Connections
    ADMIN --> DASH
    DASH -->|"HTTPS"| API
    API --> AUTH
    API -->|"Training Config"| FLCOORD

    FLCOORD -->|"Global Model + Params"| FLC
    FLC --> LT
    DS -.->|"Data stays on device"| LT
    LT -->|"Raw Update"| PRIV
    PRIV -->|"Masked Update"| FLCOORD

    FLCOORD --> SECAGG
    SECAGG -->|"Cohort Sum"| GLOBAGG
    GLOBAGG -->|"Updated Global Model"| FLCOORD

    API --> DB
    FLCOORD --> DB
    GLOBAGG --> DB
    DB -->|"Dashboard Data"| DASH

    %% Styling
    classDef serverComp fill:#1a237e,stroke:#0d47a1,color:#ffffff
    classDef edgeComp fill:#1b5e20,stroke:#2e7d32,color:#ffffff
    classDef presComp fill:#37474f,stroke:#546e7a,color:#ffffff
    classDef dataComp fill:#e65100,stroke:#bf360c,color:#ffffff
    classDef privComp fill:#4a148c,stroke:#6a1b9a,color:#ffffff

    class FLCOORD,SECAGG,GLOBAGG,API,AUTH serverComp
    class FLC,LT edgeComp
    class ADMIN,DASH presComp
    class DB,DS dataComp
    class PRIV privComp
