%%{init: {'theme': 'base'}}%%
flowchart LR
    %% =====================================================================
    %% DATA FLOW DIAGRAM - LEVEL 0 (CONTEXT DIAGRAM)
    %% Privacy-Preserving and Resource-Aware Federated Learning System
    %% Notation: Mermaid flowchart (DFD Level 0 approximation)
    %% External Entities : rectangles []
    %% Central Process   : rounded rectangle (())
    %% Data Flows        : labeled arrows
    %% =====================================================================

    %% External Entities
    ADMIN["Admin"]
    SYSOP["System Operator"]
    ED["Physical Edge Devices"]

    %% Central System Process (Process 0)
    FLSYS(["0\nPrivacy-Preserving\nFederated Learning\nSystem"])

    %% Admin flows
    ADMIN -->|"Login / Training Config / Device Management"| FLSYS
    FLSYS -->|"Auth Token / Status Reports / Performance Metrics"| ADMIN

    %% System Operator flows
    SYSOP -->|"Login / Monitoring Queries"| FLSYS
    FLSYS -->|"Training Progress / Resource Metrics / Alerts"| SYSOP

    %% Edge Device flows
    ED -->|"Device Registration / Resource Telemetry / Masked Model Updates"| FLSYS
    FLSYS -->|"Global Model / Training Instructions"| ED
    ED -.->|"Local Dataset — NEVER transmitted"| ED

    %% Styling
    classDef external fill:#37474f,stroke:#546e7a,color:#fff,font-weight:bold
    classDef process fill:#1a237e,stroke:#0d47a1,color:#fff,font-weight:bold

    class ADMIN,SYSOP,ED external
    class FLSYS process
