flowchart TB
    %% =====================================================================
    %% DATA FLOW DIAGRAM - LEVEL 2
    %% Privacy-Preserving and Resource-Aware Federated Learning System
    %%
    %% Expands Level 1 Processes P2–P5 into sub-processes:
    %%   P2: FL Coordination    → P2.1 Select Devices, P2.2 Distribute Model
    %%   P3: Local Training     → P3.1 Train, P3.2 Compute Update
    %%   P4: Privacy & Compress → P4.1 Differential Privacy, P4.2 Sparsify & Quantize, P4.3 SecAgg Mask
    %%   P5: Aggregation        → P5.1 Unmask, P5.2 Aggregate, P5.3 Evaluate & Store
    %%
    %% Notation: Mermaid flowchart (Yourdon-DeMarco DFD approximation)
    %% =====================================================================

    %% External Entities
    ADMIN["Admin"]
    ED["Physical Edge Devices"]

    %% Data Stores
    DS2[("D2: Training Rounds")]
    DS3[("D3: Models")]
    DS4[("D4: Metrics")]

    %% P2: FL Coordination (Expanded)
    subgraph P2_EXP["P2: FL Coordination (Expanded)"]
        P2_1(["P2.1\nSelect Eligible\nDevices"])
        P2_2(["P2.2\nDistribute\nGlobal Model"])
    end

    %% P3: Local Training (On Edge Device)
    subgraph P3_EXP["P3: Local Training  (on Edge Device)"]
        P3_1(["P3.1\nLocal SGD\nTraining"])
        LOCALDATA["Local Dataset D_k\n(Stays on Device — Never Transmitted)"]
        P3_2(["P3.2\nCompute\nModel Update"])
    end

    %% P4: Privacy Protection (On Edge Device)
    subgraph P4_EXP["P4: Privacy Protection & Compression  (on Edge Device)"]
        P4_1(["P4.1\nDifferential\nPrivacy\n(Clip + Noise)"])
        P4_2(["P4.2\nSparsify &\nQuantize"])
        P4_3(["P4.3\nSecAgg\nMasking"])
    end

    %% P5: Secure Aggregation (Central Server)
    subgraph P5_EXP["P5: Secure Aggregation & Global Update  (Central Server)"]
        P5_1(["P5.1\nSecAgg\nUnmask"])
        P5_2(["P5.2\nAggregate\nGlobal Model"])
        P5_3(["P5.3\nEvaluate &\nStore Metrics"])
    end

    %% Data Flows
    ADMIN -->|"Training config"| P2_1
    DS3 -->|"Current global model"| P2_2
    P2_1 -->|"Selected cohort"| P2_2
    DS2 -->|"Round record"| P2_1
    P2_2 -->|"Broadcast (model, params)"| ED

    ED -->|"Receives global model"| P3_1
    LOCALDATA -->|"Private training data"| P3_1
    P3_1 -->|"Trained weights"| P3_2
    P3_2 -->|"Raw update"| P4_1

    P4_1 -->|"Noisy clipped update"| P4_2
    P4_2 -->|"Quantized K+1 vector"| P4_3
    P4_3 -->|"Masked upload y_k"| P5_1

    P5_1 -->|"Noisy cohort sum"| P5_2
    P5_2 -->|"Updated global model"| DS3
    P5_2 -->|"Updated model"| ED
    P5_2 -->|"Model"| P5_3
    P5_3 -->|"Accuracy / epsilon / latency"| DS4
    P5_3 -->|"Round status"| DS2

    %% Styling
    classDef external fill:#37474f,stroke:#546e7a,color:#fff,font-weight:bold
    classDef process fill:#1a237e,stroke:#0d47a1,color:#fff,font-size:11px
    classDef datastore fill:#e65100,stroke:#bf360c,color:#fff
    classDef dataset fill:#b71c1c,stroke:#c62828,color:#fff,font-style:italic

    class ADMIN,ED external
    class P2_1,P2_2,P3_1,P3_2,P4_1,P4_2,P4_3,P5_1,P5_2,P5_3 process
    class DS2,DS3,DS4 datastore
    class LOCALDATA dataset
