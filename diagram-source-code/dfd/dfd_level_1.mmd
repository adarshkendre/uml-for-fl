%%{init: {'theme': 'base'}}%%
flowchart TB
    %% =====================================================================
    %% DATA FLOW DIAGRAM - LEVEL 1
    %% Privacy-Preserving and Resource-Aware Federated Learning System
    %% Notation: Mermaid flowchart (Yourdon-DeMarco DFD approximation)
    %%
    %% Processes:
    %%   P1 - Authentication and Device Registration
    %%   P2 - FL Coordination
    %%   P3 - Local Model Training
    %%   P4 - Privacy Protection and Compression
    %%   P5 - Secure Aggregation and Global Update
    %%   P6 - Monitoring and Reporting
    %% =====================================================================

    %% External Entities
    ADMIN["Admin"]
    SYSOP["System Operator"]
    ED["Physical Edge Devices"]

    %% Processes
    P1(["P1\nAuthentication &\nDevice Registration"])
    P2(["P2\nFL Coordination"])
    P3(["P3\nLocal Model\nTraining"])
    P4(["P4\nPrivacy Protection\n& Compression"])
    P5(["P5\nSecure Aggregation\n& Global Update"])
    P6(["P6\nMonitoring &\nReporting"])

    %% Data Stores
    DS1[("D1\nUsers &\nDevices")]
    DS2[("D2\nTraining\nRounds")]
    DS3[("D3\nModels")]
    DS4[("D4\nMetrics &\nLogs")]

    %% P1 flows
    ADMIN -->|"Login credentials"| P1
    SYSOP -->|"Login credentials"| P1
    ED -->|"Registration & auth request"| P1
    P1 -->|"Auth token"| ADMIN
    P1 -->|"Auth token"| SYSOP
    P1 -->|"Device ID / token"| ED
    P1 <-->|"Read / Write"| DS1

    %% P2 flows
    ADMIN -->|"Training config"| P2
    P1 -->|"Validated session"| P2
    DS1 -->|"Device list"| P2
    P2 -->|"Global model + params"| ED
    P2 -->|"Round record"| DS2
    ED -->|"Resource telemetry"| P2

    %% P3 flows
    P2 -->|"Global model"| P3
    ED -->|"Local training execution"| P3
    P3 -->|"Raw model update"| P4

    %% P4 flows
    P4 -->|"Masked protected update"| P5
    P4 -->|"Update metadata"| DS4

    %% P5 flows
    DS3 -->|"Current global model"| P5
    DS2 -->|"Round parameters"| P5
    P5 -->|"Updated global model"| DS3
    P5 -->|"Updated model"| ED
    P5 -->|"Round status"| DS2
    P5 -->|"Aggregation results"| DS4

    %% P6 flows
    DS4 -->|"Metrics"| P6
    P6 -->|"Training dashboard"| ADMIN
    P6 -->|"System status"| SYSOP

    ED -->|"Device metrics"| DS4

    %% Styling
    classDef external fill:#37474f,stroke:#546e7a,color:#fff,font-weight:bold
    classDef process fill:#1a237e,stroke:#0d47a1,color:#fff
    classDef datastore fill:#e65100,stroke:#bf360c,color:#fff

    class ADMIN,SYSOP,ED external
    class P1,P2,P3,P4,P5,P6 process
    class DS1,DS2,DS3,DS4 datastore
