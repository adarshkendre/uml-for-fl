---
title: "ER Diagram - Privacy-Preserving Federated Learning System"
---
erDiagram
    %% =====================================================================
    %% ENTITY RELATIONSHIP DIAGRAM (ERD)
    %% Privacy-Preserving and Resource-Aware Federated Learning
    %% Notation: Mermaid erDiagram (Crow's Foot)
    %% =====================================================================

    Users {
        INT    user_id   PK
        VARCHAR username
        ENUM   role      "admin | operator"
        BOOLEAN is_active
    }

    EdgeDevices {
        INT    device_id  PK
        VARCHAR device_name
        VARCHAR device_type
        ENUM   status    "registered | available | offline"
    }

    TrainingRounds {
        INT   round_id   PK
        INT   cohort_size
        FLOAT clipping_threshold
        FLOAT noise_multiplier
        ENUM  status     "in_progress | completed | failed"
        TIMESTAMP started_at
        TIMESTAMP completed_at
    }

    Models {
        INT   model_id   PK
        INT   round_id   FK
        INT   version
        FLOAT validation_accuracy
        FLOAT validation_loss
        TIMESTAMP created_at
    }

    ModelUpdates {
        INT   update_id   PK
        INT   round_id    FK
        INT   device_id   FK
        BOOLEAN dp_applied
        BOOLEAN secagg_masked
        ENUM  status      "transmitted | aggregated"
    }

    DeviceMetrics {
        INT   metric_id   PK
        INT   device_id   FK
        INT   round_id    FK
        FLOAT cpu_usage
        FLOAT ram_free_mb
        FLOAT battery_joules
        BOOLEAN admitted
    }

    TrainingMetrics {
        INT   metric_id   PK
        INT   round_id    FK
        FLOAT global_accuracy
        FLOAT cumulative_epsilon
        INT   participating_devices
    }

    %% Relationships
    Users ||--o{ TrainingRounds : "configures"
    EdgeDevices ||--o{ ModelUpdates : "submits"
    EdgeDevices ||--o{ DeviceMetrics : "reports"
    TrainingRounds ||--o{ ModelUpdates : "receives"
    TrainingRounds ||--o{ DeviceMetrics : "measures"
    TrainingRounds ||--o{ TrainingMetrics : "produces"
    TrainingRounds ||--o{ Models : "produces"
    Models ||--o{ ModelUpdates : "references"
