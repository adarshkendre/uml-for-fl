@startuml activity_diagram
'=======================================================================
' ACTIVITY DIAGRAM
' Complete Federated Learning Workflow
' Privacy-Preserving and Resource-Aware Federated Learning System
' Standard: OMG UML 2.5.1
' Notation: PlantUML with swimlanes
'=======================================================================

!theme cerulean-outline
skinparam activity {
    BackgroundColor #EDE7F6
    BorderColor #4527A0
    StartColor #1B5E20
    EndColor #B71C1C
    DiamondBackgroundColor #FFF9C4
    DiamondBorderColor #F57F17
    ArrowColor #1565C0
    FontSize 11
}
skinparam swimlane {
    BorderColor #546E7A
    TitleFontColor #FFFFFF
    TitleBackgroundColor #37474F
}

title Activity Diagram: Federated Learning Workflow

|Admin|
|Central FL Server|
|Edge Devices|

|Admin|
start
:Login and configure FL training parameters;

|Central FL Server|
:Authenticate admin;

if (Valid credentials?) then (Yes)
    :Initialize global model;
else (No)
    :Reject login;
    stop
endif

repeat

    |Central FL Server|
    :Start new training round;
    :Query device telemetry;
    :Select eligible device cohort;

    if (Enough devices available?) then (Yes)
        :Broadcast global model to cohort;
    else (No)
        :Abort round;
        stop
    endif

    |Edge Devices|

    fork
        :Device 1: receive model, train locally on D_1;
        note right
            Local dataset stays
            on device — never
            transmitted.
        end note
    fork again
        :Device 2: receive model, train locally on D_2;
    fork again
        :Device N: receive model, train locally on D_N;
    end fork

    :Apply Differential Privacy (clip + noise);
    :Apply sparsification and quantization;
    :Apply SecAgg masking;
    :Upload masked update to coordinator;

    |Central FL Server|

    if (Enough survivors within deadline?) then (Yes)
        :Unmask cohort sum (SecAgg);
    else (No)
        :Abort round — privacy guarantee violated;
        stop
    endif

    :Aggregate global model;
    :Update privacy accountant (track cumulative epsilon);
    :Evaluate model performance;
    :Store updated model and metrics;
    :Distribute updated global model to devices;

    |Admin|
    :View round results on Dashboard;

repeat while (Stopping criteria met?) is (No)
-> Yes;

|Admin|
:View final training results;
stop

@enduml
