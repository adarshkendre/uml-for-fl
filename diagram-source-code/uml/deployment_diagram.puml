@startuml deployment_diagram
'=======================================================================
' DEPLOYMENT DIAGRAM
' Physical Infrastructure
' Privacy-Preserving and Resource-Aware Federated Learning System
' Standard: OMG UML 2.5.1
' Notation: PlantUML
'=======================================================================

!theme cerulean-outline
skinparam node {
    BackgroundColor #EDE7F6
    BorderColor #4527A0
    FontSize 11
}
skinparam database {
    BackgroundColor #FFF3E0
    BorderColor #E65100
}
skinparam component {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
}

title Deployment Diagram: Physical Infrastructure\nPrivacy-Preserving Federated Learning System

' Admin Computer
node "Admin Computer" <<device>> #ECEFF1 {
    node "Web Browser" <<execution environment>> {
        component "Web Dashboard" as DASHUI
    }
}

' Central FL Server
node "Central FL Server" <<server>> #E8EAF6 {
    node "Application Runtime" <<execution environment>> {
        component "Backend API" as API
        component "FL Coordinator" as COORD
        component "Global Aggregator" as GAGG
        component "Secure Aggregator" as SA
    }
}

' Database Server
node "Database Server" <<server>> #FFF3E0 {
    database "Central Database" as DB
}

' Edge Device 1
node "Edge Device 1\n(Raspberry Pi 4)" <<device>> #E8F5E9 {
    component "FL Client" as FLC1
    component "Local Trainer + DP + Compressor" as LT1
    database "Local Dataset D_1\n(STAYS ON DEVICE)" as DS1 #FFCDD2
}

' Edge Device 2
node "Edge Device 2\n(Jetson Nano)" <<device>> #E8F5E9 {
    component "FL Client" as FLC2
    component "Local Trainer + DP + Compressor" as LT2
    database "Local Dataset D_2\n(STAYS ON DEVICE)" as DS2 #FFCDD2
}

' Additional devices note
node "Edge Device N\n(additional devices)" <<device>> #E8F5E9 {
    component "FL Client + Local Stack" as FLCN
    database "Local Dataset D_N\n(STAYS ON DEVICE)" as DSN #FFCDD2
}

' Communication Paths
"Admin Computer" -- "Central FL Server" : HTTPS
"Central FL Server" -- "Database Server" : TCP/IP
"Central FL Server" -- "Edge Device 1\n(Raspberry Pi 4)" : HTTPS (encrypted)
"Central FL Server" -- "Edge Device 2\n(Jetson Nano)" : HTTPS (encrypted)
"Central FL Server" -- "Edge Device N\n(additional devices)" : HTTPS (encrypted)

note bottom of DS1
    Raw data NEVER
    leaves this device.
end note

@enduml
