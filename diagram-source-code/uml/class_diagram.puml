@startuml class_diagram
'=======================================================================
' CLASS DIAGRAM
' Privacy-Preserving and Resource-Aware Federated Learning System
' Standard: OMG UML 2.5.1
' Notation: PlantUML
'=======================================================================

!theme cerulean-outline
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #EDE7F6
    BorderColor #4527A0
    ArrowColor #1565C0
    HeaderBackgroundColor #4527A0
    HeaderFontColor #FFFFFF
    FontSize 11
}
skinparam packageStyle rectangle

title Class Diagram\nPrivacy-Preserving Federated Learning System

' -----------------------------------------------------------------------
' CENTRAL SERVER CLASSES
' -----------------------------------------------------------------------

class FLCoordinator {
    - globalModel : Model
    - currentRound : TrainingRound
    - registeredDevices : List<EdgeDevice>
    + startRound(config : TrainingConfig) : TrainingRound
    + selectDevices(candidates : List<EdgeDevice>) : List<EdgeDevice>
    + broadcastModel(model : Model, cohort : List<EdgeDevice>) : void
    + collectUpdates(roundId : int) : void
    + distributeUpdatedModel(model : Model) : void
}

class TrainingRound {
    - roundId : int
    - cohortSize : int
    - clippingThreshold : float
    - noiseMultiplier : float
    - status : String
    - startedAt : DateTime
    + initialize() : void
    + updateStatus(status : String) : void
    + isComplete() : boolean
}

class GlobalAggregator {
    + aggregateUpdates(cohortSum : float[], mask : int[], survivorCount : int) : Model
    + evaluateModel(model : Model) : float
    + updatePrivacyAccountant(round : TrainingRound) : void
}

class SecureAggregator {
    - cohortSize : int
    + unmaskCohortSum(maskedVectors : Map<Integer, long[]>, survivorIds : List<Integer>) : long[]
    + recoverDroppedMasks(secretShares : Map<Integer, byte[]>) : long[]
}

class Dashboard {
    + displayTrainingProgress(roundId : int) : void
    + displayDeviceStatus(devices : List<EdgeDevice>) : void
    + displayModelPerformance(metrics : TrainingMetrics) : void
}

' -----------------------------------------------------------------------
' EDGE DEVICE CLASSES
' -----------------------------------------------------------------------

class EdgeDevice {
    - deviceId : int
    - deviceType : String
    - status : String
    - cpuCores : float
    - ramMb : int
    + register() : boolean
    + sendTelemetry() : DeviceMetrics
    + startTraining(round : TrainingRound) : void
}

class FLClient {
    - device : EdgeDevice
    - globalModel : Model
    + receiveModel(model : Model) : void
    + executeRound(round : TrainingRound) : void
    + uploadMaskedUpdate(update : float[]) : void
}

class LocalTrainer {
    - localEpochs : int
    - localDataset : Dataset
    + trainLocalModel(globalModel : Model) : float[]
    + applyErrorFeedback(rawUpdate : float[]) : float[]
}

class DifferentialPrivacy {
    - noiseMultiplier : float
    + clipUpdate(update : float[], threshold : float) : float[]
    + injectNoise(update : float[], variance : float) : float[]
}

class ModelCompressor {
    + applySparsification(update : float[], mask : int[]) : float[]
    + quantize(vector : float[]) : long[]
    + applySecAggMask(vector : long[]) : long[]
}

' -----------------------------------------------------------------------
' RELATIONSHIPS
' -----------------------------------------------------------------------

' Composition
FLCoordinator *-- TrainingRound : manages
FLCoordinator *-- GlobalAggregator : uses
FLCoordinator *-- SecureAggregator : uses
FLClient *-- LocalTrainer : delegates to
FLClient *-- DifferentialPrivacy : applies
FLClient *-- ModelCompressor : uses

' Aggregation
FLCoordinator o-- EdgeDevice : coordinates

' Association
FLClient o-- EdgeDevice : runs on
Dashboard --> FLCoordinator : monitors
GlobalAggregator ..> SecureAggregator : uses cohort sum

@enduml
