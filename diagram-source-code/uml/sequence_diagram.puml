@startuml sequence_diagram
'=======================================================================
' SEQUENCE DIAGRAM
' One Federated Learning Training Round
' Privacy-Preserving and Resource-Aware Federated Learning System
' Standard: OMG UML 2.5.1
' Notation: PlantUML
'=======================================================================

!theme cerulean-outline
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam sequence {
    ActorBorderColor #1B5E20
    ActorBackgroundColor #E8F5E9
    ParticipantBorderColor #4527A0
    ParticipantBackgroundColor #EDE7F6
    NoteBackgroundColor #FFF9C4
    NoteBorderColor #F57F17
}

title Sequence Diagram: One Federated Learning Training Round

' Participants
actor "Admin" as ADMIN
participant "Dashboard" as DASH
participant "FL Coordinator" as COORD
participant "Edge Device" as ED
participant "Privacy &\nCompression" as PRIV
participant "Secure\nAggregator" as SA
participant "Global\nAggregator" as GA
database "Database" as DB

' -----------------------------------------------------------------------
' PHASE 1: ADMIN CONFIGURES AND STARTS ROUND
' -----------------------------------------------------------------------
== Phase 1: Configure and Start Round ==

ADMIN -> DASH : login and configure training
DASH -> COORD : forward training config
COORD -> DB : save round (status: initializing)
COORD --> DASH : round configured

ADMIN -> DASH : start training round
DASH -> COORD : startRound()
COORD -> DB : query eligible devices
COORD -> COORD : select device cohort
COORD --> DASH : round started

' -----------------------------------------------------------------------
' PHASE 2: DISTRIBUTE GLOBAL MODEL
' -----------------------------------------------------------------------
== Phase 2: Distribute Global Model ==

COORD -> DB : fetch latest global model
par Broadcast to selected devices
    COORD ->> ED : broadcast(globalModel, clippingThreshold, coordinateMask)
end
ED --> COORD : acknowledged

' -----------------------------------------------------------------------
' PHASE 3: LOCAL TRAINING (ON EDGE DEVICES)
' -----------------------------------------------------------------------
== Phase 3: Local Training on Edge Devices ==

note over ED : Local dataset NEVER leaves the device.

loop Each selected device trains locally
    ED -> ED : run local SGD on private dataset
    ED -> ED : compute model update
end

' -----------------------------------------------------------------------
' PHASE 4: PRIVACY PROTECTION AND COMPRESSION
' -----------------------------------------------------------------------
== Phase 4: Privacy Protection and Compression ==

ED -> PRIV : apply sparsification + DP (clip + noise)
PRIV -> PRIV : sparsify, clip, inject Gaussian noise
PRIV -> PRIV : quantize and apply SecAgg mask
PRIV --> ED : masked update y_k

ED ->> COORD : upload masked update y_k

' -----------------------------------------------------------------------
' PHASE 5: SECURE AGGREGATION AND GLOBAL UPDATE
' -----------------------------------------------------------------------
== Phase 5: Secure Aggregation and Global Update ==

COORD -> SA : unmask cohort sum
SA -> SA : recover dropped masks (if any dropout)
SA --> COORD : noisy cohort sum

COORD -> GA : aggregateUpdates(cohortSum, mask, survivorCount)
GA -> GA : compute updated global model
GA -> GA : update privacy accountant (epsilon tracking)
GA --> COORD : updated global model + metrics

' -----------------------------------------------------------------------
' PHASE 6: STORE AND DISTRIBUTE
' -----------------------------------------------------------------------
== Phase 6: Store Metrics and Distribute Model ==

COORD -> DB : save updated model + training metrics
COORD -> DB : mark round completed
COORD ->> ED : distribute updated global model

COORD ->> DASH : async dashboard update (accuracy, epsilon, latency)
DASH --> ADMIN : Round complete — training progress displayed

@enduml
