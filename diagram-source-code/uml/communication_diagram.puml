@startuml communication_diagram
'=======================================================================
' COMMUNICATION DIAGRAM (Collaboration Diagram)
' Federated Learning Round Interactions
' Privacy-Preserving and Resource-Aware Federated Learning System
' Standard: OMG UML 2.5.1
' Notation: PlantUML (numbered messages consistent with
'           UML Communication Diagram semantics)
'
' NOTE: PlantUML uses sequence notation to represent Communication
' Diagrams. Numbered messages follow UML 2.5.1 conventions (1, 1.1, 2, ...).
'=======================================================================

!theme cerulean-outline
skinparam sequence {
    ArrowColor #1565C0
    ActorBorderColor #1B5E20
    ActorBackgroundColor #E8F5E9
    ParticipantBorderColor #4527A0
    ParticipantBackgroundColor #EDE7F6
    NoteBackgroundColor #FFF9C4
    NoteBorderColor #F57F17
}

title Communication Diagram: Federated Learning Round\nNumbered Messages (UML 2.5.1)

participant ":Dashboard" as DASH
participant ":FLCoordinator" as COORD
participant ":EdgeDevice" as ED
participant ":LocalTrainer" as LT
participant ":DifferentialPrivacy" as DP
participant ":ModelCompressor" as MC
participant ":SecureAggregator" as SA
participant ":GlobalAggregator" as GA
database ":Database" as DB

DASH -> COORD : 1: configureAndStartRound(config)
COORD -> DB : 1.1: saveRound(config)
DB --> COORD : 1.2: roundId

COORD -> DB : 2: getLatestGlobalModel()
DB --> COORD : 2.1: globalModel_w_t
COORD -> ED : 2.2: broadcast(globalModel, clippingThreshold, mask)

ED -> LT : 3: trainLocalModel(globalModel, D_k, epochs)
note right of LT
    D_k NEVER leaves device.
end note
LT --> ED : 3.1: rawUpdate

ED -> MC : 4: applySparsification(rawUpdate, mask)
MC --> ED : 4.1: sparsifiedUpdate

ED -> DP : 5: applyDifferentialPrivacy(sparsifiedUpdate, threshold, noise)
DP --> ED : 5.1: noisyUpdate

ED -> MC : 6: quantizeAndMask(noisyUpdate)
MC --> ED : 6.1: maskedUpload_y_k

ED -> COORD : 7: uploadMaskedUpdate(y_k, roundId)

COORD -> SA : 8: unmaskCohortSum(maskedVectors, survivorIds)
SA --> COORD : 8.1: noisyCohortSum

COORD -> GA : 9: aggregateUpdates(cohortSum, mask, survivorCount)
GA -> GA : 9.1: computeUpdatedModel()
GA -> GA : 9.2: updatePrivacyAccountant()
GA --> COORD : 9.3: updatedModel + metrics

COORD -> DB : 10: storeModel(updatedModel)
COORD -> DB : 10.1: storeMetrics(accuracy, epsilon, latency)
COORD -> DB : 10.2: markRoundComplete()

COORD -> ED : 11: distributeUpdatedModel(updatedModel)
COORD -> DASH : 12: asyncUpdate(accuracy, epsilon, latency)

@enduml
