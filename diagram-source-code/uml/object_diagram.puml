@startuml object_diagram
'=======================================================================
' OBJECT DIAGRAM
' Runtime Snapshot During One Training Round
' Privacy-Preserving and Resource-Aware Federated Learning System
' Standard: OMG UML 2.5.1
' Notation: PlantUML
'=======================================================================

!theme cerulean-outline
skinparam object {
    BackgroundColor #EDE7F6
    BorderColor #4527A0
    ArrowColor #1565C0
    HeaderBackgroundColor #4527A0
    HeaderFontColor #FFFFFF
    FontSize 11
}

title Object Diagram: Runtime Snapshot — Training Round 1

object "coordinator1 : FLCoordinator" as COORD {
    cohortSize = 3
    dropoutMax = 1
    roundDeadline = 120.0
}

object "round1 : TrainingRound" as ROUND {
    roundId = 1
    cohortSize = 3
    clippingThreshold = 1.0
    noiseMultiplier = 1.1
    status = "in_progress"
}

object "globalModel1 : Model" as GM {
    modelId = 1
    version = 3
    validationAccuracy = 0.842
    validationLoss = 0.421
}

object "device1 : EdgeDevice" as ED1 {
    deviceId = 1
    deviceType = "Raspberry Pi 4"
    status = "TrainingLocally"
    ramMb = 4096
}

object "device2 : EdgeDevice" as ED2 {
    deviceId = 2
    deviceType = "Jetson Nano"
    status = "ApplyingPrivacy"
    ramMb = 4096
}

object "device3 : EdgeDevice" as ED3 {
    deviceId = 3
    deviceType = "Generic SBC"
    status = "UploadingUpdate"
    ramMb = 2048
}

object "secAgg1 : SecureAggregator" as SA {
    cohortSize = 3
    dropoutTolerance = 1
}

object "globalAgg1 : GlobalAggregator" as GA {
    activeCoordinates = 6000
}

' Links
COORD --> ROUND : manages
COORD --> GM : distributes
COORD --> SA : triggers
COORD --> GA : invokes

ROUND --> ED1 : includes
ROUND --> ED2 : includes
ROUND --> ED3 : includes

SA --> GA : feedsCohortSum
GA --> GM : willProduce

note right of ED1
    Each device trains locally.
    Raw data never transmitted.
end note

@enduml
