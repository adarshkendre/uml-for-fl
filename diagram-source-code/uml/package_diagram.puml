@startuml package_diagram
'=======================================================================
' PACKAGE DIAGRAM
' Logical Organization of the Software System
' Privacy-Preserving and Resource-Aware Federated Learning System
' Standard: OMG UML 2.5.1
' Notation: PlantUML
'=======================================================================

!theme cerulean-outline
skinparam package {
    BackgroundColor #EDE7F6
    BorderColor #4527A0
    FontSize 12
    Style rectangle
}

title Package Diagram: Logical Software Organization\nPrivacy-Preserving Federated Learning System

' -----------------------------------------------------------------------
' SERVER-SIDE PACKAGES
' -----------------------------------------------------------------------

package "presentation" as PKG_PRES #FCE4EC {
    [Dashboard]
}

package "api" as PKG_API #E8EAF6 {
    [Backend API]
    [Auth Service]
}

package "federated_learning" as PKG_FL #EDE7F6 {
    [FL Coordinator]
    [Training Round]
    [Device Selector]
}

package "aggregation" as PKG_AGG #F3E5F5 {
    [Global Aggregator]
    [Secure Aggregator]
}

package "database" as PKG_DB #FFF3E0 {
    [Database Manager]
}

' -----------------------------------------------------------------------
' EDGE-DEVICE-SIDE PACKAGES
' -----------------------------------------------------------------------

package "edge_client" as PKG_EC #E8EAF6 {
    [FL Client]
    [Local Trainer]
}

package "privacy" as PKG_PRIV #FFF3E0 {
    [Differential Privacy]
    [Model Compressor]
    [SecAgg Masking]
}

' -----------------------------------------------------------------------
' DEPENDENCIES
' -----------------------------------------------------------------------

PKG_PRES ..> PKG_API : uses
PKG_API ..> PKG_FL : uses
PKG_API ..> PKG_DB : uses

PKG_FL ..> PKG_AGG : uses
PKG_FL ..> PKG_DB : uses

PKG_AGG ..> PKG_DB : uses

PKG_EC ..> PKG_PRIV : uses

note bottom of PKG_EC
    Runs on edge device.
end note

note bottom of PKG_FL
    Runs on central server.
end note

@enduml
