@startuml component_diagram
'=======================================================================
' COMPONENT DIAGRAM
' Software Architecture
' Privacy-Preserving and Resource-Aware Federated Learning System
' Standard: OMG UML 2.5.1
' Notation: PlantUML
'=======================================================================

!theme cerulean-outline
skinparam component {
    BackgroundColor #EDE7F6
    BorderColor #4527A0
    ArrowColor #1565C0
    FontSize 11
}
skinparam node {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
}

title Component Diagram: Software Architecture\nPrivacy-Preserving Federated Learning System

' -----------------------------------------------------------------------
' CENTRAL SERVER NODE
' -----------------------------------------------------------------------
node "Central FL Server" as SERVER #E8EAF6 {

    [Web Dashboard] as WEBDASH
    [Backend API] as API
    [Authentication Service] as AUTH
    [FL Coordinator] as FLCOORD
    [Global Aggregator] as GLOBAGG
    [Secure Aggregator] as SECAGG
    [Database] as DB

    WEBDASH --> API : HTTPS
    API --> AUTH : validate credentials
    API --> FLCOORD : training config
    FLCOORD --> SECAGG : trigger unmasking
    FLCOORD --> GLOBAGG : aggregate updates
    SECAGG --> GLOBAGG : noisy cohort sum
    GLOBAGG --> DB : store global model
    FLCOORD --> DB : persist round state
    API --> DB : read / write
}

' -----------------------------------------------------------------------
' EDGE DEVICE NODE
' -----------------------------------------------------------------------
node "Physical Edge Device k" as EDGEDEV #E8F5E9 {

    [FL Client] as FLCLIENT
    [Local Trainer] as LOCALTRAINER
    [Privacy & Compression\n(DP + Sparsification + Quantization)] as DPMC
    [SecAgg Masking] as SECAGG_CLI
    database "Local Dataset D_k\n(Stays on Device)" as LOCALDATA

    FLCLIENT --> LOCALTRAINER : trigger training
    LOCALTRAINER --> LOCALDATA : read training data
    LOCALTRAINER --> DPMC : raw update
    DPMC --> SECAGG_CLI : protected update
    SECAGG_CLI --> FLCLIENT : masked upload y_k
}

' -----------------------------------------------------------------------
' INTER-NODE COMMUNICATION
' -----------------------------------------------------------------------
FLCOORD ..> FLCLIENT : broadcast global model
FLCLIENT ..> FLCOORD : upload masked update y_k
FLCLIENT ..> FLCOORD : resource telemetry

note right of LOCALDATA
    Raw data NEVER
    transmitted to server.
end note

@enduml
